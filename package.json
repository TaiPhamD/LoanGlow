{
  "name": "loanglow",
  "version": "1.2.1",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.22",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo run:ios",
    "ios:check": "python3 scripts/ios_release.py check",
    "ios:archive": "python3 scripts/ios_release.py archive",
    "ios:upload": "python3 scripts/ios_release.py upload",
    "ios:status": "python3 scripts/ios_release.py status",
    "verify:ios-release": "python3 scripts/test_ios_release.py",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist-web",
    "verify:web": "node verify-web.cjs",
    "verify:inputs": "node verify-inputs.cjs",
    "verify:loans": "node verify-loans.cjs",
    "verify:loans-ui": "node verify-loans-ui.cjs",
    "verify:unified-ui": "node verify-unified-ui.cjs",
    "verify:modes-ui": "node verify-modes-ui.cjs",
    "verify:tax": "python3 scripts/test_build_tax_data.py && node verify-tax.cjs",
    "verify:tax-ui": "node verify-tax-ui.cjs",
    "data:tax": "python3 scripts/build_tax_data.py",
    "verify:persistence": "node verify-persistence.cjs",
    "verify:responsive": "node verify-responsive.cjs"
  },
  "private": true
}
